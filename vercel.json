{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/calendar.ics",
      "destination": "/api/ics"
    },
    {
      "source": "/e/:id.ics",
      "destination": "/api/ics?id=:id"
    },
    {
      "source": "/room/:room.ics",
      "destination": "/api/ics?room=:room"
    },
    {
      "source": "/e/:id",
      "destination": "/api/event?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/calendar.ics",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/room/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/bwalletx-theme.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
